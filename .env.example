# Placeholder-only template. Copy to .env.local (git-ignored) and fill locally.
# Never commit real values.

# REQUIRED. There is no built-in default project; missing values fail with a clear error.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Owner-confirmed classification of that project: development | test | production | unclassified
# MRV_SUPABASE_ENVIRONMENT=

# REQUIRED for imports/calculations (server only, never NEXT_PUBLIC_). Provisioned by db/supabase/0003 in
# mrv_private.executor_key; without it imports/calculations return 503 and stored runs remain readable.
# MRV_EXECUTOR_KEY_ID=
# MRV_EXECUTOR_KEY=

# HOSTED E2E only (tests/hosted/cases.ts) — test-classified project with synthetic logins; never production.
# MRV_STAGING_E2E=1
# MRV_STAGING_PROJECT_REF=<project-ref matching NEXT_PUBLIC_SUPABASE_URL>
# MRV_E2E_A_EMAIL= / MRV_E2E_A_PASSWORD=            (owner of "SYNTHETIC E2E Org A")
# MRV_E2E_B_EMAIL= / MRV_E2E_B_PASSWORD=            (owner of "SYNTHETIC E2E Org B")
# MRV_E2E_C_EMAIL= / MRV_E2E_C_PASSWORD=            (facility_manager restricted to E1)
# MRV_E2E_REVOKED_EMAIL= / MRV_E2E_REVOKED_PASSWORD= (role in E1 revoked)

# Signs short-lived evidence download tokens (>= 32 random characters). Required in production;
# development generates an ephemeral secret per server process.
# DOWNLOAD_SIGNING_SECRET=

# Planned (adapter not yet implemented — provider not selected):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# EVIDENCE_STORAGE_BUCKET=
# AUTH_SECRET=

# Canonical public application origin for browser write protection behind a reverse proxy.
# Production defaults to https://cementmrv.traceforce.net; set explicitly for other deployments.
# Exact scheme + host + optional port, no path. Never use a wildcard.
# MRV_APP_ORIGIN=https://cementmrv.traceforce.net
